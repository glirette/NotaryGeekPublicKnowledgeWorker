<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NotaryGeek_PublicKnowledge_Worker</RootNamespace>
    <ExtensionsCsProjDirectory>$(MSBuildProjectDirectory)\obj\wex</ExtensionsCsProjDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Queues" Version="12.27.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" Version="5.5.4" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.0.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.22.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="public-knowledge\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The Functions SDK still generates a net8.0 WorkerExtensions project; keep that generated build stable under the .NET 10 SDK. -->
  <Target Name="PrepareWorkerExtensionsBuildForNet10Sdk" AfterTargets="_FunctionsGenerateCommon" BeforeTargets="_WorkerExtensionsRestore;_WorkerExtensionsBuild">
    <PropertyGroup>
      <_WorkerExtensionsPlaceholderSource>$(ExtensionsCsProjDirectory)\WorkerExtensionsPlaceholder.cs</_WorkerExtensionsPlaceholderSource>
      <_WorkerExtensionsBuildOverrides>$(MSBuildProjectDirectory)\build\WorkerExtensionsBuildOverrides.targets</_WorkerExtensionsBuildOverrides>
      <_FunctionsExtensionCommonProps>$(_FunctionsExtensionCommonProps);BaseIntermediateOutputPath=$(ExtensionsCsProjDirectory)\obj\;IntermediateOutputPath=$(ExtensionsCsProjDirectory)\obj\Release\net8.0\;DebugType=portable;DebugSymbols=true;CustomAfterMicrosoftCommonTargets=$(_WorkerExtensionsBuildOverrides)</_FunctionsExtensionCommonProps>
      <_WorkerExtensionsProtectedDataSource>$(NuGetPackageRoot)system.security.cryptography.protecteddata\4.5.0\runtimes\win\lib\netstandard2.0\System.Security.Cryptography.ProtectedData.dll</_WorkerExtensionsProtectedDataSource>
      <_WorkerExtensionsProtectedDataTarget>$(ExtensionsCsProjDirectory)\bin\Release\net8.0\runtimes\win\lib\netstandard2.0\System.Security.Cryptography.ProtectedData.dll</_WorkerExtensionsProtectedDataTarget>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(_WorkerExtensionsPlaceholderSource)"
      Lines="namespace Microsoft.Azure.Functions.Worker.Extensions { internal static class BuildPlaceholder { } }"
      Overwrite="true" />
    <MakeDir Directories="$(ExtensionsCsProjDirectory)\bin\Release\net8.0\runtimes\win\lib\netstandard2.0" />
    <Copy
      SourceFiles="$(_WorkerExtensionsProtectedDataSource)"
      DestinationFiles="$(_WorkerExtensionsProtectedDataTarget)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_WorkerExtensionsProtectedDataSource)')" />
  </Target>

  <Target Name="RestoreWorkerExtensionsRuntimeAssetsForNet10Sdk" AfterTargets="_WorkerExtensionsBuild" BeforeTargets="_FunctionsExtensionAssignTargetPaths">
    <PropertyGroup>
      <_WorkerExtensionsProtectedDataSource>$(NuGetPackageRoot)system.security.cryptography.protecteddata\4.5.0\runtimes\win\lib\netstandard2.0\System.Security.Cryptography.ProtectedData.dll</_WorkerExtensionsProtectedDataSource>
      <_WorkerExtensionsProtectedDataTarget>$(ExtensionsCsProjDirectory)\bin\Release\net8.0\runtimes\win\lib\netstandard2.0\System.Security.Cryptography.ProtectedData.dll</_WorkerExtensionsProtectedDataTarget>
    </PropertyGroup>
    <MakeDir Directories="$(ExtensionsCsProjDirectory)\bin\Release\net8.0\runtimes\win\lib\netstandard2.0" />
    <Copy
      SourceFiles="$(_WorkerExtensionsProtectedDataSource)"
      DestinationFiles="$(_WorkerExtensionsProtectedDataTarget)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_WorkerExtensionsProtectedDataSource)')" />
  </Target>

  <Target Name="RestoreWorkerExtensionsRuntimeAssetsBeforeOuterCopy" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectoryAlways;_CopyOutOfDateSourceItemsToOutputDirectoryPreserveNewest">
    <PropertyGroup>
      <_WorkerExtensionsProtectedDataSource>$(NuGetPackageRoot)system.security.cryptography.protecteddata\4.5.0\runtimes\win\lib\netstandard2.0\System.Security.Cryptography.ProtectedData.dll</_WorkerExtensionsProtectedDataSource>
      <_WorkerExtensionsProtectedDataTarget>$(ExtensionsCsProjDirectory)\bin\Release\net8.0\runtimes\win\lib\netstandard2.0\System.Security.Cryptography.ProtectedData.dll</_WorkerExtensionsProtectedDataTarget>
    </PropertyGroup>
    <MakeDir Directories="$(ExtensionsCsProjDirectory)\bin\Release\net8.0\runtimes\win\lib\netstandard2.0" />
    <Copy
      SourceFiles="$(_WorkerExtensionsProtectedDataSource)"
      DestinationFiles="$(_WorkerExtensionsProtectedDataTarget)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_WorkerExtensionsProtectedDataSource)')" />
  </Target>

  <Target Name="RemoveWorkerExtensionsProtectedDataOuterCopy" AfterTargets="_FunctionsExtensionAssignTargetPaths" BeforeTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <_ExtensionRuntimeBinaries Remove="$(ExtensionsCsProjDirectory)\bin\Release\net8.0\runtimes\win\lib\netstandard2.0\System.Security.Cryptography.ProtectedData.dll" />
      <_ExtensionRuntimeBinaries Remove="$(ExtensionsCsProjDirectory)\bin\Release\net8.0\runtimes\win\lib\netstandard2.0\**\*" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveWorkerExtensionsProtectedDataSourceCopy" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="$(ExtensionsCsProjDirectory)\bin\Release\net8.0\runtimes\win\lib\netstandard2.0\System.Security.Cryptography.ProtectedData.dll" />
      <_SourceItemsToCopyToOutputDirectory Remove="$(ExtensionsCsProjDirectory)\bin\Release\net8.0\runtimes\win\lib\netstandard2.0\**\*" />
    </ItemGroup>
  </Target>
</Project>
